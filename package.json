{
  "name": "alur-jkn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:validate && pnpm copy:check && next build",
    "preview": "pnpm build && node scripts/preview-server.mjs",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:safety": "vitest run tests/safety",
    "test:a11y": "vitest run tests/a11y",
    "content:validate": "tsx scripts/validate-content.ts",
    "copy:check": "tsx scripts/copy-check.ts",
    "bundle:check": "tsx scripts/bundle-check.ts",
    "contrast:check": "tsx scripts/contrast-check.ts",
    "strings:check": "tsx scripts/strings-check.ts",
    "tokens:check": "tsx scripts/tokens-check.ts",
    "map:check": "tsx scripts/map-coverage-check.ts",
    "offline:check": "tsx scripts/offline-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/react": "4.10.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "20.14.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8",
    "eslint-config-next": "14.2.35",
    "jest-axe": "9.0.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "serve-handler": "6.1.7",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  }
}
